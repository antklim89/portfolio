{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antklim89/portfolio"
  },
  "bugs": {
    "url": "https://github.com/antklim89/portfolio/issues"
  },
  "keywords": ["nextjs", "typescript", "sass", "zod"],
  "scripts": {
    "dev": "run-p dev:**",
    "dev:next": "bun next dev --turbo",
    "dev:typecheck": "tsc --noEmit -w --preserveWatchOutput",
    "build": "bun next build",
    "start": "bun next start",
    "lint": "eslint . --fix",
    "typegen": "payload generate:types",
    "docker:dev": "docker compose -f compose.yml -f compose.dev.yml up --build --watch",
    "docker:up": "docker compose up",
    "docker:build": "docker compose build",
    "docker:start": "docker compose start",
    "docker:push": "docker push development.cr.cloud.ru/portfolio:v2",
    "migrate": "NODE_ENV=production payload migrate",
    "migrate:create": "NODE_ENV=production payload migrate:create"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "@payloadcms/db-sqlite": "^3.85.2",
    "@payloadcms/email-nodemailer": "^3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/payload-cloud": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "accept-language": "^3.0.20",
    "graphql": "^17.0.2",
    "next": "^16.2.10",
    "payload": "^3.85.2",
    "react": "19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/react": "19.2.17",
    "npm-run-all": "^4.1.5",
    "sass": "^1.101.0"
  }
}
